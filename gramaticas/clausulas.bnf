<clausula> ::= <contexto> <inicio>
<contexto> ::= TIEMPO <contexto> | AFIRMACION <contexto> | ε
<inicio> ::= <sujeto> <contexto> <predicado> | <predicado>
<sujeto> ::= ARTICULO <nucleo> | <nucleo>
<nucleo> ::= TRANSFERENCIA <datos> | ATENCION | CLARIDAD | AGENTE | DESTINATARIO | REF
<datos> ::= REF <monto-opt> | DE MONTO | ε
<monto-opt> ::= DE MONTO | ε
<predicado> ::= <prefijo> <cuerpo> <complementos>
<prefijo> ::= NO <pron-opt> | PRONOMBRE <luego-pron> | ε
<luego-pron> ::= NO <pron-opt> | ε
<pron-opt> ::= PRONOMBRE | ε
<cuerpo> ::= ENVIO | RECEPCION | DEVOLUCION | SEGUIMIENTO | SOLICITUD | ATENDER <juicio> | ENTENDER | COPULA <juicio> | CONTINUA SIN LLEGAR | AGRADECIMIENTO | PAGO | <juicio>
<juicio> ::= MUY <polaridad> | <polaridad>
<polaridad> ::= POSITIVO | NEGATIVO
<complementos> ::= <complemento> <complementos> | ε
<complemento> ::= REF | MONTO | DE MONTO | ARTICULO <objeto> | <objeto>
<objeto> ::= OBJETO | REVERSION | RECLAMO | TRANSFERENCIA | ATENCION | CLARIDAD
